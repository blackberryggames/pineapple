rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = this exact, verified email. Google sign-in is always verified;
    // email/password accounts must click the verification link first.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == '30copallock@pulaskischools.org';
    }
    function signedIn() { return request.auth != null; }

    // Anyone may bump counters by exactly 1 (play count) ...
    function onlyPlayBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playCount'])
        && request.resource.data.playCount == resource.data.playCount + 1;
    }
    // ... signed-in users may move the like counter by exactly 1.
    function onlyLikeStep() {
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (request.resource.data.likeCount == resource.data.likeCount + 1
         || request.resource.data.likeCount == resource.data.likeCount - 1);
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyPlayBump() || onlyLikeStep();

      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == uid;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Game source code is kept apart from the listing doc so the home page stays light.
    match /gameFiles/{id}     { allow read: if true; allow write: if isAdmin(); }

    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /changelogs/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /pages/{id}         { allow read: if true; allow write: if isAdmin(); }
  }
}
